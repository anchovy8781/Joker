# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------- database
POSTGRES_USER=yex
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=yex

# ---------------------------------------------------------------- backend
# development | production   (production refuses to start with insecure settings)
YEX_ENV=development
# Random 32+ char secret used to hash IP addresses (raw IPs are never stored).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
YEX_IP_HASH_SECRET=replace-with-a-random-48-char-secret-value-0000000
# false only for http://localhost development. MUST be true behind HTTPS.
YEX_COOKIE_SECURE=false
# JSON list of allowed browser origins (the web app's public URL).
YEX_CORS_ORIGINS=["http://localhost:3000"]
# Number of trusted reverse proxies in front of the web app that append X-Forwarded-For
# (e.g. 1 for Caddy/nginx). 0 = ignore the header.
YEX_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- optional, free
# YouTube Data API v3 key (Google Cloud Console; free daily quota, no billing needed).
# Empty = only DEMO channels are updated; real channels stay halted until data arrives.
YEX_YOUTUBE_API_KEY=
# Cloudflare Turnstile secret (free) for high-risk signups. Empty = disabled.
YEX_TURNSTILE_SECRET=

# ---------------------------------------------------------------- frontend
WEB_PORT=3000

# Host ports (change if already in use)
DB_PORT=5432
API_PORT=8000
